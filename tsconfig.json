{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@mermaid-parser/*": ["src/mermaid-parser/*"],
      "@layout-engine/*": ["src/layout-engine/*"],
      "@svg-compositor/*": ["src/svg-compositor/*"],
      "@sidecar/*": ["src/sidecar/*"],
      "@edit/*": ["src/edit/*"],
      "@viewport/*": ["src/viewport/*"],
      "@error/*": ["src/error/*"]
    }
  },
  "include": ["src"]
}
